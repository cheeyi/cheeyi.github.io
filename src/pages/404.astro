---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="404 - Page Not Found" description="The page you're looking for doesn't exist." />
		<style>
			.error-container {
				min-height: 60vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 2rem;
			}

			.error-code {
				font-size: 8rem;
				font-weight: 700;
				color: var(--accent);
				margin: 0;
				line-height: 1;
			}

			.error-message {
				font-size: 1.5rem;
				color: rgb(var(--gray-dark));
				margin: 1rem 0 2rem;
			}

			.error-description {
				font-size: 1rem;
				color: rgb(var(--gray));
				max-width: 500px;
				margin-bottom: 2rem;
			}

			.home-link {
				display: inline-block;
				padding: 1rem 2rem;
				background: var(--accent);
				color: white;
				text-decoration: none;
				border-radius: 30px;
				font-weight: 700;
				transition: background-color 0.2s ease;
			}

			.home-link:hover {
				background: var(--accent-hover);
				color: white;
			}

			@media (max-width: 720px) {
				.error-code {
					font-size: 5rem;
				}

				.error-message {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-container">
				<h1 class="error-code">404</h1>
				<p class="error-message">Oops! Page not found.</p>
				<p class="error-description">
					The page you're looking for seems to have wandered off into the digital void.
					Let's get you back on track!
				</p>
				<a href="/" class="home-link">Take me home</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
