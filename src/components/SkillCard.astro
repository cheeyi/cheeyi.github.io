---
import { Icon } from 'astro-icon/components';
import type { Skill } from '../data/skills';

interface Props {
	category: string;
	skills: Skill[];
}

const { category, skills } = Astro.props;
---

<div class="skill-category">
	<h3 class="skill-category-title">{category}</h3>
	<div class="skill-grid">
		{skills.map((skill) => (
			<div class="skill-card">
				<div class="skill-content">
					{skill.icon && (
						<Icon name={skill.icon} class="skill-icon" aria-label={skill.name} />
					)}
					<span class="skill-name">{skill.name}</span>
				</div>
			</div>
		))}
	</div>
</div>

<style>
	.skill-category {
		margin-bottom: 2.5rem;
	}

	.skill-category-title {
		font-size: 1.25em;
		margin-bottom: 1rem;
		color: rgb(var(--black));
		position: relative;
		display: inline-block;
	}

	.skill-category-title::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--accent);
	}

	.skill-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.skill-card {
		background: var(--bg-secondary);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1rem;
		transition: border-color 0.2s ease;
	}

	.skill-card:hover {
		border-color: var(--accent);
	}

	.skill-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.skill-icon {
		width: 2rem;
		height: 2rem;
		line-height: 1;
	}

	.skill-name {
		font-weight: 600;
		font-size: 0.9em;
		color: rgb(var(--black));
		text-align: center;
	}

	@media (max-width: 720px) {
		.skill-grid {
			grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
			gap: 0.75rem;
		}

		.skill-card {
			padding: 0.75rem;
		}

		.skill-icon {
			width: 1.5rem;
			height: 1.5rem;
		}

		.skill-name {
			font-size: 0.85em;
		}
	}
</style>
